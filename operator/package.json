{
  "name": "autolien-operator",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app that drives carrier verification sweeps via Playwright on the user's machine.",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run clean && npm run build:main && npm run build:preload && npm run build:renderer && npm run copy:assets",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --external:electron --outfile=dist/main/preload.js --format=cjs --sourcemap",
    "build:renderer": "esbuild src/renderer/index.ts --bundle --platform=browser --outfile=dist/renderer/bundle.js --format=iife --sourcemap",
    "copy:assets": "node scripts/copy-assets.js",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "lint": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "firebase": "^10.13.0",
    "playwright-core": "^1.45.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.5",
    "rimraf": "^5.0.7",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.autolientracker.operator",
    "productName": "AutoLien Operator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"]
    }
  }
}
